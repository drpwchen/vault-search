# ============================================================================
# vault-search configuration. Copy this file to `.env` and edit.
# Only VAULT_PATH is required.
#   cp env.example .env
# ============================================================================

# --- REQUIRED -----------------------------------------------------------------
# Absolute path to your Obsidian vault (the folder containing your .md notes).
VAULT_PATH=/home/you/Documents/MyVault
# Windows example:
# VAULT_PATH=C:\Users\you\Documents\MyVault

# --- Data directory (all indexes, caches and logs live here) ------------------
# VAULT_SEARCH_DATA_DIR=~/.vault-search

# --- Ollama / embedding model -------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# Vault notes embedding model (bilingual, 1024-dim). `ollama pull bge-m3`
# VAULT_SEARCH_EMBEDDING_MODEL=bge-m3
# VAULT_SEARCH_EMBEDDING_DIM=1024

# Folders never indexed (comma-separated, matched against top-level path).
# VAULT_SEARCH_SKIP_FOLDERS=.obsidian,.trash,.git,node_modules

# --- Vault v2 index (parent-child chunking, optional) -------------------------
# v2 embeds small child chunks for a precise hit and returns the surrounding
# subsection (the parent) for context. It lives in its own tables, so you can
# build it, compare it against v1, and only then switch.
#   python server/vault_indexer_v2.py              # build it
#   touch ~/.vault-search/vault_v2.enabled         # searches now read v2
#   rm    ~/.vault-search/vault_v2.enabled         # back to v1
# No restart is needed either way. If v2 is enabled but its index is missing or
# broken, searches fall back to v1 and record the reason in the vault search log.
# VAULT_SEARCH_V2_FLAG=~/.vault-search/vault_v2.enabled
# Embedding model for v2. Defaults to VAULT_SEARCH_TEXTBOOK_MODEL below, but is
# its own knob — a vault-only install needs no textbook corpus to use v2.
# VAULT_SEARCH_V2_MODEL=qwen3-embedding:0.6b
# Instruction prefix prepended to every vault QUERY (Qwen3 instruct format).
# Customize for your domain. Documents are embedded WITHOUT it, so editing this
# changes queries only and never invalidates the index.
# VAULT_SEARCH_V2_QUERY_PREFIX=Instruct: Given a query, retrieve the most relevant passages from the user's personal notes.\nQuery:
# Readable name for that template, recorded in the search log alongside a hash
# of the prefix itself (so the name can never claim a template you aren't using).
# VAULT_SEARCH_V2_TEMPLATE_VERSION=qwen3-vault-v1
# Where the vault search log goes (the textbook corpus has its own).
# VAULT_SEARCH_VAULT_LOG_PATH=~/.vault-search/vault_search_log.jsonl

# --- API server ---------------------------------------------------------------
# VAULT_SEARCH_API_HOST=0.0.0.0
# VAULT_SEARCH_API_PORT=3789

# --- Thin MCP client (server/mcp_thin.py) -----------------------------------
# Where mcp_thin.py looks for the API server. Set the full URL only if the server
# is not on localhost; otherwise VAULT_SEARCH_API_PORT above is enough.
# VAULT_SEARCH_API_URL=http://127.0.0.1:3789

# --- Chat backend -------------------------------------------------------------
# Path to the `claude` CLI (used for Hybrid/Free chat via your Claude subscription).
# Leave as "claude" if it's on your PATH. Set empty to disable Claude-backed chat.
# CLAUDE_CMD=claude
# Local Ollama chat model for zero-cost Vault-mode chat. `ollama pull gemma2:9b`
# VAULT_SEARCH_CHAT_MODEL=gemma2:9b
# Assistant persona + reply language (customize for your domain).
# VAULT_SEARCH_PERSONA=You are a knowledgeable assistant helping the user reason over their personal notes.
# VAULT_SEARCH_LANGUAGE=Answer in the same language as the user's question.

# --- Reranking (optional) -----------------------------------------------------
# Boost folders you trust, demote others. JSON object, folder -> multiplier.
# VAULT_SEARCH_PATH_WEIGHTS={"Reference":1.2,"Archive":0.8}
# Folder treated as "archived" (deprioritized unless include_archived=true).
# VAULT_SEARCH_ARCHIVE_FOLDER=Archive
# Substrings marking derivative notes to hide from search by default.
# VAULT_SEARCH_EXCLUDE_PATTERNS=draft,scratch,cowork

# --- Knowledge graph (optional) -----------------------------------------------
# Extra markdown dir (e.g. a glossary) used to canonicalize NER entities.
# VAULT_SEARCH_ENTITY_CANON_DIR=
# Folders whose notes get entity extraction FIRST. Extraction is slow and often
# time-boxed, so this decides what gets covered when a run cannot finish
# everything. Empty (default) = no folder is favoured, newest notes first.
# VAULT_SEARCH_ENTITY_PRIORITY_FOLDERS=Reference,Projects

# --- Textbook / secondary corpus (optional) -----------------------------------
# A second corpus of long-form reference docs, indexed with its own model.
# Leave unset to disable textbook search entirely.
# VAULT_SEARCH_TEXTBOOK_PATH=/home/you/Documents/reference-md
# VAULT_SEARCH_TEXTBOOK_MODEL=qwen3-embedding:0.6b
# Filenames never indexed from that corpus (comma-separated, matched on basename).
# Applied globally. A book left with nothing to index is kept instead, with a
# warning — so a typo here cannot silently erase a book.
# VAULT_SEARCH_TEXTBOOK_SKIP_FILES=INDEX.md
# Whole-book files that duplicate per-chapter siblings. Skipped only in books that
# actually have chapter files, so a book whose whole-book file is its only copy
# stays searchable. This is what stops every page being embedded twice and each
# query returning the same passage twice.
# Set to an empty value to index whole-book files even where chapters exist.
# VAULT_SEARCH_TEXTBOOK_WHOLE_BOOK_FILES=full_text.md
# What a chapter filename looks like — the evidence that the whole-book file beside
# it is redundant. A stray README.md must not count, or it would displace the only
# copy of an unsplit book. The default matches ch01_x.md, 01_x.md, pages_0001-0030.md.
# A corpus that names chapters some other way keeps both files (duplicates, never
# data loss); point this at your own convention to deduplicate it.
# VAULT_SEARCH_TEXTBOOK_CHAPTER_PATTERN=^(?:(?:ch(?:apter)?|pp?|pages?|part|sect?(?:ion)?|vol(?:ume)?)[ _.\-]?)?\d+[ _.\-]
# Per-source ranking boost (see examples/source_boost.example.json).
# VAULT_SEARCH_SOURCE_BOOST=/abs/path/to/source_boost.json

# --- GPU lease (optional) -----------------------------------------------------
# Only needed if something ELSE on this machine also wants the GPU. A small card
# cannot host the embedding model and another GPU job at once: the Ollama runner
# dies under VRAM pressure and whole embedding batches fail, which shows up as
# silently missing chunks rather than as an error.
#
# Point this at a machine-wide lease script and both indexers will take a turn
# like any other job: acquire before touching the GPU, refuse to run without it,
# and yield between files so a one-minute job does not wait out an hours-long
# index run. Unset (the default) = no coordination, indexing just runs.
# The script must accept: acquire --name N --timeout S | release --name N |
# heartbeat --name N | waiters   (exit 0 = someone queued, 1 = nobody)
# VAULT_SEARCH_GPU_LEASE=/abs/path/to/gpu_lease.py
# Names the two indexers register under (they are separate jobs).
# VAULT_SEARCH_GPU_LEASE_NAME_TEXTBOOK=vault_search_textbook_index
# VAULT_SEARCH_GPU_LEASE_NAME_VAULT=vault_search_vault_index
# How long to wait for a turn before giving up (seconds; default 6 h).
# VAULT_SEARCH_GPU_LEASE_TIMEOUT=21600
# Minimum hold before yielding, so queued jobs cannot cause release/re-acquire
# thrash that never makes progress (seconds).
# VAULT_SEARCH_GPU_LEASE_MIN_HOLD=180
# The lease script's state directory. Optional: knowing it lets the yield check
# peek at the queue with a directory listing instead of spawning a subprocess
# once per file. Without it the check is time-throttled instead.
# VAULT_SEARCH_GPU_LEASE_STATE=~/.local/state/gpu-lease
